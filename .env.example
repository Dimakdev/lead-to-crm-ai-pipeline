# Lead -> CRM AI pipeline (n8n + Airtable + Claude). Copy to .env and fill in. Never commit .env.

# n8n: Settings -> n8n API -> Create an API key
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Airtable personal access token: https://airtable.com/create/tokens
# scopes: data.records:read, data.records:write, schema.bases:read (schema.bases:write only if you let the script create tables)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# LLM: the workflow ships with the Google Gemini chat model (workflow.json built with --provider gemini).
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if you rebuild with --provider anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram alerts: bot token from @BotFather, chat id of the person/group that receives alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail OAuth2 is created in the n8n UI (Google consent screen). Paste the credential id from its URL
# (.../home/credentials/<id>) so deploy.py can wire the four Gmail nodes; leave empty to pick it by hand.
GMAIL_CREDENTIAL_ID=

# Shared secret for POST /webhook/lead-intake (header: x-webhook-secret). Leave empty: deploy.py generates one.
WEBHOOK_SECRET=
